# Copy this file to .env and fill in the values.

# PostgreSQL connection. Create the database first:  createdb phwando
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/phwando?schema=public"

# Public address of the site, used in SMS links (no trailing slash)
APP_URL="http://localhost:3000"

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Lenco (https://lenco.co). Leave LENCO_API_KEY empty, or set LENCO_MOCK=true, to fake payments locally.
LENCO_API_KEY=""
LENCO_BASE_URL="https://api.lenco.co/access/v2"
LENCO_MOCK="true"
# Optional: shown on the dashboard as estimated fees, e.g. 2.5
LENCO_FEE_PERCENT=""

# SMS gateway (not wired yet; messages are printed to the server log until it is)
SMS_PROVIDER=""

# Where message photos are stored
UPLOAD_DIR="./uploads"

# First organiser account, created by `npm run db:seed`
SEED_OWNER_EMAIL="owner@phwando.test"
SEED_OWNER_PASSWORD="change-me"

# Throwaway database for `npm test` (the database tests are skipped when this is empty).
# With docker compose:  postgresql://phwando:phwando@localhost:5432/phwando_test?schema=public
TEST_DATABASE_URL=""
